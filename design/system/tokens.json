{
  "version": "P5-A",
  "direction": "Atlas+ provisional",
  "primitives": {
    "paper": "#F4F1E9",
    "white": "#FFFFFF",
    "paper2": "#EAE6DC",
    "ink": "#20232B",
    "muted": "#535B66",
    "line": "#747B87",
    "blue": "#3346D3",
    "blueHover": "#2737A9",
    "blueSoft": "#E6E9FF",
    "green": "#1C7148",
    "greenSoft": "#E8F3EC",
    "red": "#B42318",
    "redSoft": "#FDEDEA",
    "amber": "#795700",
    "amberSoft": "#FFF1D0",
    "graphite": "#151922",
    "graphite2": "#202936",
    "mint": "#6EE7C5",
    "gold": "#F2C14E",
    "light": "#F4F6FB",
    "secondary": "#BDC7D9",
    "disabled": "#E4E6EA",
    "disabledText": "#596270",
    "marker": "#D9EF73"
